# Copier en .env (jamais dans Git). Le MÊME fichier .env est utilisé par les 4 membres :
# mêmes mots de passe MySQL, même JWT_SECRET, mêmes clés d'API, mêmes adresses IP.

MYSQL_DATABASE=db_location_voitures
MYSQL_USER=location_app
MYSQL_PASSWORD=replace_with_url_safe_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_root_password
JWT_SECRET=replace_with_a_long_random_secret_shared_with_the_auth_service
JWT_TTL_MINUTES=60
RESERVATION_SERVICE_TIMEOUT_SECONDS=5
CORS_ORIGINS=http://localhost:3000
# Service Réservation : clés des services appelants (nom:clé,…), ex. contrats:<clé longue aléatoire>
RESERVATION_SERVICE_API_KEYS=
# Même clé que la partie « contrats: » ci-dessus, envoyée par le service Contrat (en-tête X-API-Key)
CONTRAT_RESERVATION_API_KEY=
# true tant que service_contrat lit les réservations sans jeton ; passer à false ensuite
RESERVATION_LECTURE_PUBLIQUE=true
# Devise affichée par le service Réservation (à harmoniser entre services)
DEVISE=MAD

# ---- Mode multi-PC (compose.leila.yaml, compose.maryam.yaml, compose.sara.yaml, compose.hasna.yaml) ----
# Adresse IP de chaque PC sur le réseau commun (ipconfig → « Adresse IPv4 »). Inutile avec compose.yaml (un seul PC).
IP_LEILA=192.168.1.10
IP_MARYAM=192.168.1.11
IP_SARA=192.168.1.12
IP_HASNA=192.168.1.13
