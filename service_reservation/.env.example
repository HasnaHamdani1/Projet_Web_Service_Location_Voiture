# ===== Service Réservation (Maryam) – configuration Tailscale =====
# Copier en .env (jamais dans Git) et remplacer les valeurs entre < >.
# Adresses Tailscale : commande « tailscale ip -4 » sur la machine de chacune.

# --- Base de données UNIQUE de l'équipe (hébergée par Hasna) ---
DATABASE_URL=mysql+pymysql://location_app:<mot-de-passe>@<IP-Tailscale-de-Hasna>:3306/db_location_voitures
# Test en solo avec « --profile base-locale » :
# DATABASE_URL=mysql+pymysql://location_app:location_app@mysql:3306/db_location_voitures

# --- Services de Leila ---
VEHICLE_SERVICE_URL=http://100.112.66.13:8005
AUTH_API_URL=http://100.112.66.13:8014
# Tableau de bord admin de Leila (connexion de l'agence, puis menu « Réservations »)
ADMIN_DASHBOARD_URL=http://100.112.66.13:3000/admin/login.html

# --- Sécurité ---
# Même valeur exactement que le JWT_SECRET du service Auth de Leila
JWT_SECRET=<secret-partagé-avec-Leila>
# Clés des services qui appellent cette API (en-tête X-API-Key) : nom:clé,nom:clé
SERVICE_API_KEYS=contrats:<clé-pour-Sara>,retours:<clé-pour-Hasna>
# true : lectures possibles sans clé (pendant l'intégration) ; false quand Sara et Hasna envoient leur clé
LECTURE_PUBLIQUE=true

# --- Paramètres ---
CLIENT_PROVIDER=db
DEVISE=MAD
EMAIL_BACKEND=console
APP_TIMEZONE=Africa/Casablanca
