# Sous-chemin de déploiement ("/" par défaut)
VITE_BASE_PATH=/
# Adresses des API vues par le navigateur (relayées par Vite en dev, par nginx en Docker)
VITE_RESERVATION_API_URL=/api/reservation
VITE_AUTH_API_URL=/api/auth
# Photos des véhicules (champ image_url du service Véhicule, ex. /uploads/clio.jpg)
VITE_VEHICLE_ASSETS_URL=/api/vehicule
# Cibles du relais de développement (ports publiés par compose.yaml)
VITE_PROXY_RESERVATION=http://localhost:8002
VITE_PROXY_AUTH=http://localhost:8004
VITE_PROXY_VEHICULE=http://localhost:8001
# Liens du menu de l'espace agence vers les pages des autres membres (frontend commun, port 3000)
VITE_MODULE_VEHICULES_URL=http://localhost:3000/admin/dashboard.html
VITE_MODULE_CONTRATS_URL=http://localhost:3000/Contrat/index.html
VITE_MODULE_RETOURS_URL=http://localhost:3000/
VITE_MODULE_PARAMETRES_URL=
