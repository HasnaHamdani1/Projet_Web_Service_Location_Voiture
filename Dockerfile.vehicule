
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements_vehicule.txt ./requirements.txt

# Connexion lente vers PyPI : délai et nombre de tentatives de pip augmentés
ENV PIP_DEFAULT_TIMEOUT=300 PIP_RETRIES=10
RUN pip install --no-cache-dir -r requirements.txt \
    && addgroup --system --gid 10002 appgroup \
    && adduser --system --uid 10002 --ingroup appgroup appuser \
    && mkdir -p /app/uploads \
    && chown -R appuser:appgroup /app/uploads

COPY --chown=appuser:appgroup acces.py database.py models.py main.py ./

USER appuser

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
